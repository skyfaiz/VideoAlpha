INFINITETALK_ENDPOINT_ID=your-infinitetalk-endpoint-id
WANANIMATE_ENDPOINT_ID=your-wananimate-endpoint-id
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_MCP_URL=https://mcp.runpod.io/
# Terminate an idle GPU Pod when no job is submitted within this many seconds (0 disables)
POD_IDLE_TIMEOUT_SECONDS=180

S3_ENDPOINT_URL=https://s3api-eu-ro-1.runpod.io
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_BUCKET_NAME=your-bucket-name
S3_REGION=eu-ro-1

# Amazon Polly (Server-side AWS credentials or leave blank if using EC2 IAM Instance Role)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
POLLY_S3_BUCKET_NAME=
POLLY_S3_KEY_PREFIX=polly-outputs/
